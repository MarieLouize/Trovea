{
  "name": "trovea-monorepo",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run api:dev\" \"npm run web:dev\"",
    "web:dev": "npm run dev -w @trovea/web",
    "web:build": "npm run build -w @trovea/web",
    "api:dev": "npm run start:dev -w @trovea/api",
    "api:build": "npm run build -w @trovea/api",
    "build:all": "npm run api:build && npm run web:build",
    "install:all": "npm install",
    "lint": "npm run lint -w @trovea/web && npm run lint -w @trovea/api"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
